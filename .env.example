# Copiez ce fichier en ".env". Tout est facultatif.

# Analyse par IA (payant). Laissez vide pour l'analyse gratuite par règles.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Port du site (http://localhost:3000)
PORT=3000

# Taille maximale d'une vidéo envoyée, en Go (4 par défaut)
MAX_UPLOAD_GB=4

# Supprime les Shorts de plus de N jours (0 = ne rien supprimer). Les Shorts « à valider » sont gardés.
KEEP_DAYS=0

# Publication YouTube (gratuit, voir README)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
