# Copiez ce fichier en ".env". Tout est facultatif.

# Analyse par IA (payant). Laissez vide pour l'analyse gratuite par règles.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Port du site (http://localhost:3000)
PORT=3000

# Taille maximale d'une vidéo envoyée, en Go (4 par défaut)
MAX_UPLOAD_GB=4

# Supprime les Shorts de plus de N jours (0 = ne rien supprimer).
KEEP_DAYS=0

# Titres, descriptions et hashtags par IA GRATUITE (Google Gemini). Clé gratuite : https://aistudio.google.com/apikey
# Vide = titres simples sans IA. GEMINI_MODEL : à changer si Google renomme le modèle.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Cadrage auto : si l'action est répartie sur toute l'image (jeu vidéo, interface), garde l'image entière sur fond flou.
# 0.5 par défaut ; 0 = toujours recadrer ; 1 = toujours image entière.
AUTO_BLUR_THRESHOLD=0.5

# Publication YouTube (gratuit, voir README)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
